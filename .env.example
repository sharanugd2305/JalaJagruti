# JalaJagruti AI — credentials
# Copy this file to .env and fill in your own values. Never commit .env.

# Copernicus Data Space Ecosystem (Sentinel Hub OAuth client)
# Create at: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings  (OAuth clients)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# NASA Earthdata / LAADS DAAC download token (EDL bearer token)
# Generate at: https://urs.earthdata.nasa.gov/  (Generate Token)
NASA_EARTHDATA_TOKEN=
# Copernicus Climate Data Store personal access token
# Find at: https://cds.climate.copernicus.eu/profile
# Also accept the ERA5-Land licence on the dataset page before running.
CDS_API_KEY=
